#!/bin/bash
# PageVault daemon control
# Usage: pagevault start|stop|restart|status|update|run|transfer [on|off]

SCRIPTS="$HOME/pagevault/scripts"
STATE="$HOME/pagevault/state"
CONFIG="$HOME/pagevault/config/listener.conf"
UNIT="pagevault.service"
UNIT_FILE="$HOME/.config/systemd/user/$UNIT"

# rtl_airband installs to /usr/local/bin. Minimal environments (cron, systemd)
# leave that off PATH, and the daemon invokes rtl_airband by bare name.
export PATH="/usr/local/sbin:/usr/local/bin:$PATH"

DAEMON=$(ls "$SCRIPTS"/pagevault_daemon_v*.py 2>/dev/null | sort -V | tail -1)

# Prefer systemd whenever the user unit is installed. It owns the process,
# restarts it on failure, and kills the whole cgroup (rtl_airband, parec, sox,
# multimon-ng) on stop. Running nohup/pkill alongside Restart=always would just
# fight the supervisor.
use_systemd() {
    [ -f "$UNIT_FILE" ] \
        && command -v systemctl > /dev/null 2>&1 \
        && systemctl --user show-environment > /dev/null 2>&1
}

case "${1:-}" in
    start)
        if use_systemd; then
            systemctl --user start "$UNIT"
            sleep 3
            if systemctl --user is-active --quiet "$UNIT"; then
                echo "Started (systemd: $UNIT)"
                exit 0
            fi
            echo "Failed to start. Check: journalctl --user -u pagevault -n 50"
            exit 1
        fi

        if pgrep -f pagevault_daemon > /dev/null; then
            echo "Daemon already running (PID: $(pgrep -f pagevault_daemon | head -1))"
            exit 1
        fi
        if [ -z "$DAEMON" ]; then
            echo "No daemon script found in $SCRIPTS"
            exit 1
        fi
        nohup python3 "$DAEMON" >> "$STATE/daemon.log" 2>&1 &
        sleep 3
        if pgrep -f pagevault_daemon > /dev/null; then
            echo "Started (PID: $(pgrep -f pagevault_daemon | head -1))"
        else
            echo "Failed to start. Check $STATE/daemon.log"
            exit 1
        fi
        ;;
    stop)
        if use_systemd; then
            systemctl --user stop "$UNIT"
            echo "Stopped (systemd: $UNIT)"
            exit 0
        fi
        pkill -f pagevault_daemon 2>/dev/null
        pkill -f rtl_airband 2>/dev/null
        pkill -f "parec.*pv_" 2>/dev/null
        pkill -f multimon-ng 2>/dev/null
        sleep 2
        echo "Stopped"
        ;;
    restart)
        if use_systemd; then
            systemctl --user restart "$UNIT"
            echo "Restarted (systemd: $UNIT)"
            exit 0
        fi
        $0 stop
        sleep 2
        $0 start
        ;;
    run)
        # Foreground daemon. This is the ExecStart target of the systemd user
        # unit, which is why version resolution lives here and not in the unit
        # file -- a daemon version bump must not require rewriting the unit.
        if [ -z "$DAEMON" ]; then
            echo "No daemon script found in $SCRIPTS"
            exit 1
        fi
        exec python3 "$DAEMON"
        ;;
    status)
        if use_systemd; then
            systemctl --user is-active "$UNIT" > /dev/null 2>&1 \
                && echo "Unit: $UNIT active" \
                || echo "Unit: $UNIT inactive"
        fi
        if [ -f "$SCRIPTS/status.sh" ]; then
            "$SCRIPTS/status.sh"
        elif [ -f "$STATE/status.txt" ]; then
            cat "$STATE/status.txt"
        else
            echo "No status available"
        fi
        ;;
    update)
        # setup.sh --update restarts the daemon itself once scripts are in place
        if [ -f "$SCRIPTS/update.sh" ]; then
            "$SCRIPTS/update.sh"
        elif [ -f "$SCRIPTS/setup.sh" ]; then
            "$SCRIPTS/setup.sh" --update
        else
            echo "No update script found in $SCRIPTS"
            exit 1
        fi
        ;;
    transfer)
        # Toggles whether transfer_logs.sh actually uploads anything. The
        # daemon and decoding are untouched either way -- this only affects
        # whether logs/ready/ gets swept to the server or just accumulates
        # locally for review.
        if [ ! -f "$CONFIG" ]; then
            echo "No listener config found at $CONFIG -- run setup.sh first"
            exit 1
        fi

        case "${2:-}" in
            on)
                # shellcheck disable=SC1090
                source "$CONFIG"
                if [ -z "$REMOTE_HOST" ] || [ -z "$REMOTE_USER" ]; then
                    echo "Warning: REMOTE_USER/REMOTE_HOST are not set yet."
                    echo "Transfer will stay a no-op until this listener is registered"
                    echo "(re-run setup.sh, which prompts for a registration token)."
                fi

                sed -i 's|^TRANSFER_ENABLED=.*|TRANSFER_ENABLED=true|' "$CONFIG"
                chmod 600 "$CONFIG"

                # The flag alone does nothing if setup never installed the
                # cron job -- which is exactly what happens when transfer was
                # left off during registration.
                if [ -f "$SCRIPTS/transfer_logs.sh" ] \
                    && ! crontab -l 2>/dev/null | grep -q "transfer_logs.sh"; then
                    (crontab -l 2>/dev/null; echo "# PageVault -- transfer completed logs daily at 00:05 UTC") | crontab -
                    (crontab -l 2>/dev/null; echo "5 0 * * * $SCRIPTS/transfer_logs.sh >> $STATE/transfer.log 2>&1") | crontab -
                    echo "Log file transfer: ON (cron job installed, daily at 00:05 UTC)"
                else
                    echo "Log file transfer: ON"
                fi
                ;;
            off)
                sed -i 's|^TRANSFER_ENABLED=.*|TRANSFER_ENABLED=false|' "$CONFIG"
                chmod 600 "$CONFIG"
                echo "Log file transfer: OFF (files still decode locally to logs/ready/)"
                ;;
            "")
                # shellcheck disable=SC1090
                source "$CONFIG"
                if [ "${TRANSFER_ENABLED:-false}" = "true" ]; then
                    echo "Log file transfer: ON"
                else
                    echo "Log file transfer: OFF"
                fi
                ;;
            *)
                echo "Usage: pagevault transfer [on|off]"
                exit 1
                ;;
        esac
        ;;
    *)
        echo "Usage: pagevault start|stop|restart|status|update|run|transfer [on|off]"
        exit 1
        ;;
esac
